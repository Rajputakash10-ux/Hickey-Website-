{
  "redirects": [
    {
      "source": "/cart/:path*",
      "destination": "https://checkout.hickey.co.in/cart/:path*",
      "permanent": false
    },
    {
      "source": "/checkouts/:path*",
      "destination": "https://checkout.hickey.co.in/checkouts/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
